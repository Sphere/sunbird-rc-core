pipeline {
    agent any   // the agent must have docker, git and unzip; use agent { label 'docker' } if you have labelled nodes

    options {
        disableConcurrentBuilds()          // build dirs below are shared, so one build at a time
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'BRANCH',     defaultValue: 'schema-load-fix', description: 'Git branch to build')
        string(name: 'REPO_URL',   defaultValue: 'https://github.com/Sphere/sunbird-rc-core.git', description: 'Git repository')
        string(name: 'TAG_PREFIX', defaultValue: '0.0.13.1-work', description: 'Image tag prefix; the short commit hash is appended')
        string(name: 'IMAGE_REPO', defaultValue: 'aastardev1/sunbird-rc-core', description: 'Docker Hub repository')
        booleanParam(name: 'PUSH', defaultValue: true, description: 'Push the image to Docker Hub')
    }

    environment {
        BUILD_DIR    = '/var/tmp/rc-build'
        IMAGE_DIR    = '/var/tmp/rc-image'
        M2_DIR       = '/var/tmp/m2-rc'
        MIN_FREE_GB  = '10'
    }

    stages {
        stage('Checkout') {
            steps {
                sh '''
                    set -eu
                    rm -rf "$BUILD_DIR"
                    git clone -b "$BRANCH" --depth 1 "$REPO_URL" "$BUILD_DIR"
                    git -C "$BUILD_DIR" log -1 --oneline
                    cp "$BUILD_DIR/java/registry/src/main/resources/frame.json.sample" \
                       "$BUILD_DIR/java/registry/src/main/resources/frame.json"
                    cp "$BUILD_DIR/java/claim/src/main/resources/application.properties.sample" \
                       "$BUILD_DIR/java/claim/src/main/resources/application.properties"
                '''
            }
        }


        stage('Maven build (Java 8)') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$M2_DIR"
                    # Run as the Jenkins user so the next build can delete these files
                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e MAVEN_CONFIG=/var/maven/.m2 \
                        -v "$BUILD_DIR":/src \
                        -v "$M2_DIR":/var/maven/.m2 \
                        -w /src/java \
                        maven:3.8.6-openjdk-8 \
                        mvn -B -Duser.home=/var/maven clean install -DskipTests
                    ls -la "$BUILD_DIR/java/registry/target/registry.jar"
                '''
            }
        }

        stage('Docker build') {
            steps {
                script {
                    def shortSha = sh(returnStdout: true, script: 'git -C "$BUILD_DIR" rev-parse --short HEAD').trim()
                    env.IMAGE_TAG = "${params.TAG_PREFIX}_${shortSha}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.BRANCH} ${env.IMAGE_TAG}"
                }
                sh '''
                    set -eu
                    rm -rf "$IMAGE_DIR" && mkdir -p "$IMAGE_DIR" && cd "$IMAGE_DIR"
                    unzip -q "$BUILD_DIR/java/registry/target/registry.jar"
                    cp "$BUILD_DIR/java/Dockerfile" .
                    echo "Tag: $IMAGE_TAG"
                    docker build -t "$IMAGE_REPO:$IMAGE_TAG" .
                '''
            }
        }

        stage('Docker push') {
            when { expression { params.PUSH } }
            steps {
                sh 'docker push "$IMAGE_REPO:$IMAGE_TAG"'
            }
        }
    }

    post {
        success { echo "Built ${params.IMAGE_REPO}:${env.IMAGE_TAG} from ${params.BRANCH}" }
    }
}
